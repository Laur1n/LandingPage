---
import { getCollection, render } from "astro:content";
import { getSiteTexts } from "../../lib/site-texts";
import TeaserCta from "../blocks/TeaserCta.astro";

// Landing teaser (hybrid IA): one line + locations; the full offer lives on /unterricht/.
const [entry] = await getCollection("teaching");
const { Content } = await render(entry);
const { sections, teasers } = await getSiteTexts();
---

<section id="unterricht" class="unterricht">
  <div class="container unterricht__grid">
    <div data-reveal>
      <p class="section-eyebrow">{sections.unterrichtEyebrow}</p>
      <h2 class="section-heading">{sections.unterrichtHeading}</h2>
      {entry.data.subtitle && <p class="unterricht__subtitle">{entry.data.subtitle}</p>}
      <div class="unterricht__body">
        <Content />
      </div>
      <TeaserCta href="/unterricht/" label={teasers.unterrichtCtaLabel} />
    </div>
    <ul class="unterricht__locations" data-reveal>
      {entry.data.locations.map((location) => <li>{location}</li>)}
    </ul>
  </div>
</section>

<style>
  .unterricht {
    padding-block: var(--space-4xl);
  }

  .unterricht__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: var(--space-3xl);
    align-items: start;
  }

  .unterricht__subtitle {
    margin-top: var(--space-xl);
    font-size: var(--text-lg);
    color: var(--color-ink-muted);
  }

  .unterricht__body :global(p) {
    color: var(--color-ink-muted);
  }

  .unterricht__locations {
    list-style: none;
    margin: 0;
    padding: var(--space-lg) 0 0;
    border-top: 1px solid var(--color-border);
    display: grid;
    gap: var(--space-sm);
  }

  .unterricht__locations li {
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }

  @media (max-width: 48rem) {
    .unterricht__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
