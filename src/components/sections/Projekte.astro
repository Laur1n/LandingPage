---
import { getCollection } from "astro:content";
import { getSiteTexts } from "../../lib/site-texts";
import { firstParagraph } from "../../lib/format";
import { sortByOrder } from "../../lib/order";
import TeaserCta from "../blocks/TeaserCta.astro";

// Landing teaser (hybrid IA): name + first paragraph per project; depth lives on /projekte/
// and the program pages. The first body paragraph is authored to stand alone as a teaser.
const { sections, teasers } = await getSiteTexts();
const entries = sortByOrder(await getCollection("projects"));
---

<section id="projekte" class="projekte">
  <div class="container">
    <p class="section-eyebrow">{sections.projekteEyebrow}</p>
    <h2 class="section-heading">{sections.projekteHeading}</h2>
    <ol class="projekte__list">
      {
        entries.map((entry, index) => (
          <li class="projekte__item" data-reveal>
            <span class="index-numeral" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <div>
              <h3 class="projekte__name">{entry.data.name}</h3>
              <p class="projekte__excerpt">{firstParagraph(entry.body)}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <div class="projekte__actions" data-reveal>
      <TeaserCta href="/canzoni-italiane/" label={teasers.programCtaLabel} prominent />
      <TeaserCta href="/projekte/" label={teasers.projekteCtaLabel} />
    </div>
  </div>
</section>

<style>
  .projekte {
    padding-block: var(--space-4xl);
    background: var(--color-surface-raised);
  }

  .projekte__list {
    list-style: none;
    margin: var(--space-2xl) 0 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .projekte__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-lg);
    padding-block: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .projekte__name {
    font-size: var(--text-lg);
    font-weight: 500;
    margin-bottom: var(--space-sm);
  }

  .projekte__excerpt {
    color: var(--color-ink-muted);
    margin: 0;
  }

  .projekte__actions {
    margin-top: var(--space-xl);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-md) var(--space-xl);
  }
</style>
