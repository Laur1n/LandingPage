---
import { getCollection, render } from "astro:content";
import { getSiteTexts } from "../../lib/site-texts";
import { telHref } from "../../lib/format";
import TeaserCta from "../blocks/TeaserCta.astro";

const [entry] = await getCollection("contact");
const { email, phone, phoneMobile, location, socialLinks } = entry.data;
const { Content } = await render(entry);
const { sections, teasers } = await getSiteTexts();

const phones = [phone, phoneMobile].filter((value): value is string => Boolean(value));
---

<section id="kontakt" class="kontakt">
  <div class="container">
    <p class="section-eyebrow">{sections.kontaktEyebrow}</p>
    <h2 class="section-heading">{sections.kontaktHeading}</h2>
    <div class="kontakt__intro">
      <Content />
    </div>
    <div class="kontakt__details" data-reveal>
      <a class="kontakt__primary" href={`mailto:${email}`}>{email}</a>
      {
        phones.map((value) => (
          <a class="kontakt__secondary" href={telHref(value)}>
            {value}
          </a>
        ))
      }
      {location && <p class="kontakt__location">{location}</p>}
      <p class="kontakt__cta">
        <TeaserCta href="/kontakt/" label={teasers.kontaktCtaLabel} />
      </p>
    </div>
    {
      socialLinks && socialLinks.length > 0 && (
        <ul class="kontakt__social">
          {socialLinks.map((link) => (
            <li>
              <a href={link.url}>{link.label}</a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .kontakt {
    padding-block: var(--space-4xl);
  }

  .section-heading {
    max-width: 24ch;
  }

  .kontakt__intro {
    margin-top: var(--space-xl);
  }

  .kontakt__intro :global(p) {
    color: var(--color-ink-muted);
    margin: 0 0 var(--space-sm);
  }

  .kontakt__details {
    margin-top: var(--space-2xl);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
  }

  .kontakt__primary {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    text-decoration: none;
    color: var(--color-ink);
  }

  .kontakt__primary:hover,
  .kontakt__primary:focus-visible {
    color: var(--color-accent);
  }

  .kontakt__secondary {
    font-size: var(--text-lg);
  }

  .kontakt__location {
    color: var(--color-ink-muted);
    margin: 0;
  }

  .kontakt__cta {
    margin: var(--space-md) 0 0;
  }

  .kontakt__social {
    list-style: none;
    display: flex;
    gap: var(--space-lg);
    padding: 0;
    margin: var(--space-xl) 0 0;
  }

  @media (max-width: 48rem) {
    .kontakt {
      padding-block: var(--space-2xl);
    }

    .kontakt__primary {
      font-size: var(--text-lg);
      word-break: break-word;
    }
  }
</style>
