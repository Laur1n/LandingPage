---
import { getCollection } from "astro:content";
import { getUpcomingTourDates } from "../../lib/tour-dates";
import { getSiteTexts } from "../../lib/site-texts";
import DateList from "../blocks/DateList.astro";
import TeaserCta from "../blocks/TeaserCta.astro";

// Landing teaser (hybrid IA): the next few dates; the full list + archive lives on /termine/.
const { sections, teasers, downloads } = await getSiteTexts();
const allDates = await getCollection("tour-dates");
const upcoming = getUpcomingTourDates(allDates).slice(0, 3);
---

<section id="termine" class="termine">
  <div class="container">
    <p class="section-eyebrow">{sections.termineEyebrow}</p>
    <h2 class="section-heading">{sections.termineHeading}</h2>

    {
      upcoming.length === 0 ? (
        <p class="termine__empty" data-reveal>
          {sections.termineEmpty} <a href="/kontakt/">{sections.termineEmptyCtaLabel}</a>
        </p>
      ) : (
        <div class="termine__list">
          <DateList
            dates={upcoming}
            ticketLabel={sections.termineTicketLabel}
            externalLinkHint={downloads.externalLinkHint}
          />
        </div>
      )
    }

    <p class="termine__cta" data-reveal>
      <TeaserCta href="/termine/" label={teasers.termineCtaLabel} />
    </p>
  </div>
</section>

<style>
  .termine {
    padding-block: var(--space-4xl);
  }

  .termine__empty {
    margin-top: var(--space-xl);
    font-size: var(--text-lg);
    color: var(--color-ink-muted);
  }

  .termine__list {
    margin-top: var(--space-2xl);
  }

  .termine__cta {
    margin-top: var(--space-xl);
  }
</style>
