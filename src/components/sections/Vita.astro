---
import { getCollection } from "astro:content";
import { getSiteTexts } from "../../lib/site-texts";
import TeaserCta from "../blocks/TeaserCta.astro";

// Landing teaser (hybrid IA): short excerpt + link — the full Kurzvita lives on /vita/.
const [entry] = await getCollection("biography");
const { sections, teasers } = await getSiteTexts();
---

<section id="vita" class="vita">
  <div class="container vita__grid">
    <div class="vita__portrait" data-scene="portrait-parallax">
      <img src={entry.data.portrait} alt={entry.data.portraitAlt} loading="lazy" decoding="async" />
    </div>
    <div class="vita__text" data-reveal>
      <p class="vita__eyebrow">{sections.vitaEyebrow}</p>
      <h2 class="vita__heading">{entry.data.tagline}</h2>
      <p class="vita__teaser">{entry.data.teaser}</p>
      <TeaserCta href="/vita/" label={teasers.vitaCtaLabel} />
    </div>
  </div>
</section>

<style>
  .vita {
    padding-block: var(--space-4xl);
  }

  .vita__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: var(--space-3xl);
    align-items: center;
  }

  .vita__portrait img {
    border-radius: 0.25rem;
    width: 100%;
  }

  .vita__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: var(--text-sm);
    color: var(--color-accent);
    font-weight: 600;
    margin-bottom: var(--space-sm);
  }

  .vita__heading {
    font-size: var(--text-xl);
    font-style: italic;
    font-weight: 400;
    margin-bottom: var(--space-xl);
    max-width: 20ch;
  }

  .vita__teaser {
    color: var(--color-ink-muted);
    font-size: var(--text-lg);
  }

  @media (max-width: 56rem) {
    .vita__grid {
      grid-template-columns: 1fr;
    }

    .vita__portrait {
      max-width: 20rem;
    }
  }
</style>
