---
import { getCollection } from "astro:content";
import { getSiteTexts } from "../../lib/site-texts";
import TeaserCta from "../blocks/TeaserCta.astro";

const [entry] = await getCollection("about");
const { sections, teasers } = await getSiteTexts();
---

<section id="ueber-mich" class="about">
  <div class="container about__grid">
    <div class="about__portrait" data-scene="portrait-parallax">
      <img src={entry.data.portrait} alt={entry.data.portraitAlt} loading="lazy" decoding="async" />
    </div>
    <div class="about__text" data-reveal>
      <p class="section-eyebrow">{sections.aboutEyebrow}</p>
      <h2 class="about__heading">{sections.aboutHeading}</h2>
      <p class="about__teaser">{entry.data.teaser}</p>
      <TeaserCta href="/ueber-mich/" label={teasers.aboutCtaLabel} />
    </div>
  </div>
</section>

<style>
  .about {
    padding-block: var(--space-4xl);
    border-bottom: 2px solid var(--color-ink);
  }

  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: var(--space-3xl);
    align-items: center;
  }

  .about__portrait {
    position: relative;
  }

  .about__portrait::after {
    content: "";
    position: absolute;
    inset: var(--space-md) calc(-1 * var(--space-md)) calc(-1 * var(--space-md)) auto;
    width: var(--space-md);
    background: var(--color-bauhaus-yellow);
    z-index: -1;
  }

  .about__portrait img {
    width: 100%;
    border: 2px solid var(--color-ink);
  }

  .about__heading {
    font-size: var(--text-xl);
    margin-bottom: var(--space-xl);
    max-width: 24ch;
  }

  .about__teaser {
    color: var(--color-ink-muted);
    font-size: var(--text-lg);
  }

  @media (max-width: 56rem) {
    .about__grid {
      grid-template-columns: 1fr;
    }

    .about__portrait {
      max-width: 18rem;
    }

    .about__portrait::after {
      display: none;
    }
  }
</style>
