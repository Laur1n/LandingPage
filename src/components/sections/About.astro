---
import { getCollection } from "astro:content";
import { getSiteTexts } from "../../lib/site-texts";
import TeaserCta from "../blocks/TeaserCta.astro";

const [entry] = await getCollection("about");
const { sections, teasers } = await getSiteTexts();
---

<section id="ueber-mich" class="about">
  <div class="container about__grid">
    <div class="about__portrait" data-scene="portrait-parallax">
      <img src={entry.data.portrait} alt={entry.data.portraitAlt} loading="lazy" decoding="async" />
    </div>
    <div class="about__text" data-reveal>
      <p class="about__eyebrow">{sections.aboutEyebrow}</p>
      <h2 class="about__heading">{sections.aboutHeading}</h2>
      <p class="about__teaser">{entry.data.teaser}</p>
      <TeaserCta href="/ueber-mich/" label={teasers.aboutCtaLabel} />
    </div>
  </div>
</section>

<style>
  .about {
    padding-block: var(--space-4xl);
  }

  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: var(--space-3xl);
    align-items: center;
  }

  .about__portrait img {
    border-radius: 0.25rem;
    width: 100%;
  }

  .about__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: var(--text-sm);
    color: var(--color-accent);
    font-weight: 600;
    margin-bottom: var(--space-sm);
  }

  .about__heading {
    font-size: var(--text-xl);
    margin-bottom: var(--space-xl);
    max-width: 24ch;
  }

  .about__teaser {
    color: var(--color-ink-muted);
    font-size: var(--text-lg);
  }

  @media (max-width: 56rem) {
    .about__grid {
      grid-template-columns: 1fr;
    }

    .about__portrait {
      max-width: 20rem;
    }
  }
</style>
