---
import { getCollection } from "astro:content";
import { getSiteTexts } from "../../lib/site-texts";
import { byGermanTitle, sortByOrder } from "../../lib/order";
import CdCover from "../blocks/CdCover.astro";
import TeaserCta from "../blocks/TeaserCta.astro";

// Landing teaser (hybrid IA): cover strip (motion scene L6); details live on /cds/.
const { sections, teasers } = await getSiteTexts();
const entries = sortByOrder(await getCollection("discography"), byGermanTitle);
---

<section id="cds" class="cds">
  <div class="container">
    <p class="section-eyebrow">{sections.cdsEyebrow}</p>
    <h2 class="section-heading">{sections.cdsHeading}</h2>
  </div>
  <div class="cds__strip-wrap" data-scene="cd-strip">
    <ul class="cds__strip">
      {
        entries.map((entry) => (
          <li class="cds__item">
            <a href="/cds/" class="cds__cover-link">
              <CdCover
                title={entry.data.title}
                coverImage={entry.data.coverImage}
                coverImageAlt={entry.data.coverImageAlt}
                size={300}
              />
            </a>
            <p class="cds__title">{entry.data.title}</p>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="container">
    <p class="cds__cta" data-reveal>
      <TeaserCta href="/cds/" label={teasers.cdsCtaLabel} />
    </p>
  </div>
</section>

<style>
  .cds {
    padding-block: var(--space-4xl);
    background: var(--color-surface-raised);
    overflow: clip;
    /* Placeholder covers sit on the raised section, so they use the page surface tone. */
    --cd-cover-bg: var(--color-surface);
  }

  .cds__strip-wrap {
    margin-top: var(--space-2xl);
  }

  .cds__strip {
    list-style: none;
    margin: 0;
    padding: 0 var(--space-lg);
    display: flex;
    gap: var(--space-lg);
    justify-content: center;
    flex-wrap: wrap;
  }

  .cds__item {
    width: clamp(7rem, 12vw, 10rem);
  }

  .cds__cover-link {
    display: block;
  }

  .cds__title {
    margin: var(--space-sm) 0 0;
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    text-align: center;
  }

  .cds__cta {
    margin-top: var(--space-xl);
  }
</style>
