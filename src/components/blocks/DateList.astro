---
/**
 * Tour-date rows — FR-006. Used for the upcoming block and for each archive year group;
 * renders gracefully with whatever fields an entry has (spec edge case: incomplete dates).
 */
import type { CollectionEntry } from "astro:content";
import { DEFAULT_ENSEMBLE } from "../../lib/tour-dates";
import ExternalLink from "./ExternalLink.astro";

interface Props {
  dates: CollectionEntry<"tour-dates">[];
  ticketLabel: string;
  externalLinkHint: string;
}

const { dates, ticketLabel, externalLinkHint } = Astro.props;

const dateFormatter = new Intl.DateTimeFormat("de-DE", {
  day: "2-digit",
  month: "2-digit",
  year: "numeric",
});
const timeFormatter = new Intl.DateTimeFormat("de-DE", {
  hour: "2-digit",
  minute: "2-digit",
});
---

<ul class="date-list">
  {
    dates.map((entry) => (
      <li class="date-list__item" data-reveal>
        <time datetime={entry.data.date.toISOString()} class="date-list__date">
          <span class="date-list__day">{dateFormatter.format(entry.data.date)}</span>
          <span class="date-list__time">{timeFormatter.format(entry.data.date)} Uhr</span>
        </time>
        <div class="date-list__details">
          <p class="date-list__ensemble">{entry.data.ensemble ?? DEFAULT_ENSEMBLE}</p>
          <p class="date-list__venue">{entry.data.venueName}</p>
          <p class="date-list__location">{entry.data.location}</p>
          {entry.data.notes && <p class="date-list__notes">{entry.data.notes}</p>}
        </div>
        {entry.data.eventLink && (
          <span class="date-list__link">
            <ExternalLink href={entry.data.eventLink} label={ticketLabel} hint={externalLinkHint} />
          </span>
        )}
      </li>
    ))
  }
</ul>

<style>
  .date-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .date-list__item {
    display: grid;
    grid-template-columns: 8rem 1fr auto;
    align-items: baseline;
    gap: var(--space-lg);
    padding-block: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .date-list__item:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .date-list__date {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
  }

  .date-list__day {
    font-size: var(--text-lg);
  }

  .date-list__time {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    font-family: var(--font-body);
  }

  .date-list__ensemble {
    margin: 0;
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    font-weight: 600;
  }

  .date-list__venue {
    font-weight: 600;
    margin: 0;
  }

  .date-list__location,
  .date-list__notes {
    margin: 0;
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }

  .date-list__link {
    white-space: nowrap;
  }

  @media (max-width: 40rem) {
    .date-list__item {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
    }
  }
</style>
