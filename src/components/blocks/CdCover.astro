---
/**
 * Square CD cover with the shared no-cover fallback (title in italics) and alt-text rule —
 * used by the CD grid card and the landing cover strip. Set `--cd-cover-bg` on a parent to
 * adjust the placeholder background per surface.
 */
interface Props {
  title: string;
  coverImage?: string;
  coverImageAlt?: string;
  /** Rendered width/height attribute (square) — layout is CSS-driven. */
  size?: number;
}

const { title, coverImage, coverImageAlt, size = 400 } = Astro.props;
---

<div class="cd-cover">
  {
    coverImage ? (
      <img
        src={coverImage}
        alt={coverImageAlt ?? `Cover: ${title}`}
        loading="lazy"
        decoding="async"
        width={size}
        height={size}
      />
    ) : (
      <span class="cd-cover__placeholder" aria-hidden="true">
        <span>{title}</span>
      </span>
    )
  }
</div>

<style>
  .cd-cover {
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 0.25rem;
    background: var(--cd-cover-bg, var(--color-surface-raised));
  }

  .cd-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cd-cover__placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    padding: var(--space-sm);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    text-align: center;
  }
</style>
