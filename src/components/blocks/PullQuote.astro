---
/**
 * Large display quote — editorial Bauhaus, no italic costume.
 */
interface Props {
  quote: string;
  attribution?: string;
}

const { quote, attribution } = Astro.props;
const quoted = `„${quote.replace(/^[„"]|[“"]$/g, "")}“`;
---

<figure class="pull-quote">
  <blockquote class="pull-quote__text">{quoted}</blockquote>
  {attribution && <figcaption class="pull-quote__attribution">— {attribution}</figcaption>}
</figure>

<style>
  .pull-quote {
    margin: 0;
    padding-block: var(--space-lg);
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: 1rem 1fr;
  }

  .pull-quote::before {
    content: "";
    width: 1rem;
    background: var(--color-bauhaus-red);
  }

  .pull-quote__text {
    margin: 0;
    border: none;
    padding: 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1.2;
    max-width: 28ch;
    text-wrap: balance;
  }

  .pull-quote__attribution {
    grid-column: 2;
    color: var(--color-ink-muted);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 700;
  }
</style>
