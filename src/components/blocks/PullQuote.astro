---
/**
 * Large display quote. When an attribution exists it is rendered inside the same <figure> —
 * quote and attribution never separate (spec edge case, FR-004). German typographic quote
 * marks are added here, once, so CMS fields store the raw sentence.
 */
interface Props {
  quote: string;
  attribution?: string;
}

const { quote, attribution } = Astro.props;
const quoted = `„${quote.replace(/^[„"]|[“"]$/g, "")}“`;
---

<figure class="pull-quote">
  <blockquote class="pull-quote__text">{quoted}</blockquote>
  {attribution && <figcaption class="pull-quote__attribution">— {attribution}</figcaption>}
</figure>

<style>
  .pull-quote {
    margin: 0;
    padding-block: var(--space-2xl);
  }

  .pull-quote__text {
    margin: 0;
    border: none;
    padding: 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-style: italic;
    font-weight: 400;
    line-height: 1.3;
    max-width: 28ch;
    text-wrap: balance;
  }

  .pull-quote__attribution {
    margin-top: var(--space-lg);
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
