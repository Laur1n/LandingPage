---
import { getSiteTexts } from "../lib/site-texts";

const { brand, nav } = await getSiteTexts();

// Public site navigation. MUST NOT link to /admin (Constitution III / FR-014) —
// the admin surface is reached only by typing the URL directly. Labels are editable in the
// CMS; the anchors stay in code so a renamed label can never break a link.
const navItems = [
  { href: "#start", label: nav.start },
  { href: "#vita", label: nav.vita },
  { href: "#projekte", label: nav.projekte },
  { href: "#termine", label: nav.termine },
  { href: "#cds", label: nav.cds },
  { href: "#unterricht", label: nav.unterricht },
  { href: "#kontakt", label: nav.kontakt },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href="#start">{brand}</a>
    <nav aria-label="Hauptnavigation">
      <ul class="site-header__nav">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in oklch, var(--color-surface) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    padding-block: var(--space-md);
  }

  .site-header__brand {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
  }

  .site-header__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md) var(--space-lg);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__nav a {
    color: var(--color-ink-muted);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .site-header__nav a:hover,
  .site-header__nav a:focus-visible {
    color: var(--color-accent);
  }

  @media (max-width: 40rem) {
    .site-header__inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .site-header__nav {
      gap: var(--space-sm) var(--space-md);
    }
  }
</style>
