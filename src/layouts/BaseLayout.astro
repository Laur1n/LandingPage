---
// Self-hosted fonts (002 research.md §2): bundled woff2 via @fontsource, replacing the former
// Google Fonts CDN links — no third-party request on page load (GDPR / LG München I
// 3 O 17493/20, FR-017), no render-blocking cross-origin CSS. `font-display: swap` is built in.
import "@fontsource-variable/archivo";
import "@fontsource/atkinson-hyperlegible/400.css";
import "@fontsource/atkinson-hyperlegible/700.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getSiteTexts } from "../lib/site-texts";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const { skipLinkLabel } = await getSiteTexts();
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("lw-theme");
          const theme =
            stored === "light" || stored === "dark"
              ? stored
              : window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
          document.documentElement.dataset.theme = theme;
        } catch {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{skipLinkLabel}</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <script>
      if (
        window.matchMedia("(prefers-reduced-motion: no-preference)").matches &&
        document.querySelector("[data-reveal], [data-scene], [data-hero-line]")
      ) {
        import("../scripts/scroll-story");
      }
    </script>
  </body>
</html>
