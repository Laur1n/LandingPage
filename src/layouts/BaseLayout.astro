---
import "../styles/global.css";
import { getSiteTexts } from "../lib/site-texts";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const { skipLinkLabel } = await getSiteTexts();
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!--
      GitHub Pages serves this exact build at two URLs: the default
      https://mrarno3108.github.io/mamaLanding/ (subpath) and the custom domain
      https://francesca-simone.com/ (root) once DNS is configured. Every asset link in this
      build is root-relative (correct for the custom domain), so visiting the subpath URL
      directly would 404 every CSS/font/image. Rather than picking one via Astro's `base` config
      (which would just break the other), redirect the subpath URL straight to the real domain —
      both URLs end up working for a visitor, with no path-prefixing trade-off in the codebase.
      Runs before any other resource tag to avoid a flash of unstyled content.
    -->
    <script is:inline>
      if (window.location.hostname === "mrarno3108.github.io") {
        window.location.replace(
          "https://francesca-simone.com" +
            window.location.pathname.replace(/^\/mamaLanding/, "") +
            window.location.search +
            window.location.hash,
        );
      }
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

    <!-- Bodoni Moda (display) + Hanken Grotesk (body) — see .impeccable.md Design Tokens -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;0,6..96,600;1,6..96,400&family=Hanken+Grotesk:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
    />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{skipLinkLabel}</a>
    <slot name="header" />
    <main id="main-content">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
