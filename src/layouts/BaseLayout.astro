---
// Self-hosted fonts (002 research.md §2): bundled woff2 via @fontsource, replacing the former
// Google Fonts CDN links — no third-party request on page load (GDPR / LG München I
// 3 O 17493/20, FR-017), no render-blocking cross-origin CSS. `font-display: swap` is built in.
import "@fontsource-variable/bodoni-moda";
import "@fontsource-variable/bodoni-moda/wght-italic.css";
import "@fontsource-variable/hanken-grotesk";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getSiteTexts } from "../lib/site-texts";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const { skipLinkLabel } = await getSiteTexts();
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!--
      GitHub Pages serves this exact build at two URLs: the default
      https://mrarno3108.github.io/mamaLanding/ (subpath) and the custom domain
      https://francesca-simone.com/ (root) once DNS is configured. Every asset link in this
      build is root-relative (correct for the custom domain), so visiting the subpath URL
      directly would 404 every CSS/font/image. Rather than picking one via Astro's `base` config
      (which would just break the other), redirect the subpath URL straight to the real domain —
      both URLs end up working for a visitor, with no path-prefixing trade-off in the codebase.
      Runs before any other resource tag to avoid a flash of unstyled content.
    -->
    <script is:inline>
      if (window.location.hostname === "mrarno3108.github.io") {
        window.location.replace(
          "https://francesca-simone.com" +
            window.location.pathname.replace(/^\/mamaLanding/, "") +
            window.location.search +
            window.location.hash,
        );
      }
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{skipLinkLabel}</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <!--
      002 US3: scroll choreography. The gsap bundle is dynamic-imported (its own chunk, no CDN)
      only when the visitor allows motion AND the page has animation targets — reduced-motion
      visitors and the legal pages never pay for it (contracts/motion.md). /admin/ has its own
      index.html and never loads this.
    -->
    <script>
      if (
        window.matchMedia("(prefers-reduced-motion: no-preference)").matches &&
        document.querySelector("[data-reveal], [data-scene], [data-hero-line], [data-cd-card]")
      ) {
        import("../scripts/scroll-story");
      }
    </script>
  </body>
</html>
