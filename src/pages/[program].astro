---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Prose from "../components/blocks/Prose.astro";
import PullQuote from "../components/blocks/PullQuote.astro";
import Lineup from "../components/blocks/Lineup.astro";
import DownloadLink from "../components/blocks/DownloadLink.astro";
import { getSiteTexts } from "../lib/site-texts";
import { RESERVED_SLUGS } from "../lib/routes";

/**
 * FR-004/FR-012: one page per `programs` entry (e.g. /canzoni-italiane/), owner-creatable via
 * the CMS. Astro gives file-based routes (vita.astro, …) priority over this dynamic route —
 * a program slugged like a core page would be silently shadowed, so the build fails loudly
 * instead (the Decap hint on the title field lists the same reserved names).
 */
export async function getStaticPaths() {
  const programs = await getCollection("programs");
  for (const entry of programs) {
    if ((RESERVED_SLUGS as readonly string[]).includes(entry.id)) {
      throw new Error(
        `Program slug "${entry.id}" collides with a core page and would never render. ` +
          `Rename the entry (reserved: ${RESERVED_SLUGS.join(", ")}).`,
      );
    }
  }
  return programs.map((entry) => ({ params: { program: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { brand, downloads, program: programTexts } = await getSiteTexts();
const [contact] = await getCollection("contact");

const emailHref = `mailto:${contact.data.email}?subject=${encodeURIComponent(
  `${programTexts.emailSubjectPrefix} ${entry.data.title}`,
)}`;
---

<BaseLayout title={`${entry.data.title} · ${brand}`} description={entry.data.intro}>
  <header class="program-hero">
    <div class="container program-hero__grid">
      <div>
        {
          entry.data.subtitle && (
            <p class="section-eyebrow" data-hero-line>
              {entry.data.subtitle}
            </p>
          )
        }
        <h1 class="program-hero__title" data-hero-line>{entry.data.title}</h1>
        <p class="program-hero__intro" data-hero-line>{entry.data.intro}</p>
        <div class="program-hero__actions" data-hero-line>
          <a class="cta-pill" href="/kontakt/">{programTexts.bookingCtaLabel}</a>
          {
            entry.data.audioSample && (
              <div class="program-hero__audio">
                <span class="program-hero__audio-label">▶ {downloads.audioLabel}</span>
                <audio controls preload="none" src={entry.data.audioSample} />
              </div>
            )
          }
        </div>
      </div>
      {
        entry.data.heroImage && (
          <figure class="program-hero__figure">
            <img
              src={entry.data.heroImage}
              alt={entry.data.heroImageAlt ?? ""}
              loading="eager"
              decoding="async"
              data-program-hero-image
            />
          </figure>
        )
      }
    </div>
  </header>

  {
    entry.data.quote && (
      <div class="container">
        <PullQuote quote={entry.data.quote} attribution={entry.data.quoteAttribution} />
      </div>
    )
  }

  <div class="container">
    <Prose>
      <Content />
    </Prose>
  </div>

  {
    entry.data.lineup && entry.data.lineup.length > 0 && (
      <div class="container program-page__lineup">
        <Lineup heading={programTexts.lineupHeading} members={entry.data.lineup} />
      </div>
    )
  }

  {
    (entry.data.pitchHeading || entry.data.pitchText) && (
      <section class="program-page__pitch" data-reveal>
        <div class="container">
          {entry.data.pitchHeading && (
            <h2 class="program-page__pitch-heading">{entry.data.pitchHeading}</h2>
          )}
          {entry.data.pitchText && <p class="program-page__pitch-text">{entry.data.pitchText}</p>}
          <div class="program-page__pitch-actions">
            <a class="cta-pill" href={emailHref}>
              {programTexts.emailCtaLabel}
            </a>
            {entry.data.flyer && (
              <DownloadLink
                href={entry.data.flyer.file}
                label={entry.data.flyer.label || programTexts.flyerCtaLabel}
              />
            )}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .program-hero {
    padding-block: var(--space-4xl) var(--space-3xl);
    overflow: clip;
  }

  .program-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: var(--space-3xl);
    align-items: center;
  }

  .program-hero__title {
    font-size: var(--text-2xl);
    max-width: 12ch;
    text-wrap: balance;
  }

  .program-hero__intro {
    margin-top: var(--space-lg);
    font-size: var(--text-lg);
    color: var(--color-ink-muted);
    max-width: 45ch;
  }

  .program-hero__actions {
    margin-top: var(--space-xl);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-lg);
  }

  .program-hero__audio {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .program-hero__audio-label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink-muted);
  }

  .program-hero__figure {
    margin: 0;
  }

  /* aspect-ratio reserves the image's space before it loads — keeps CLS at ~0 regardless of
     which photo the owner uploads (FR-013). */
  .program-hero__figure img {
    border-radius: 0.25rem;
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  .program-page__lineup {
    padding-block: var(--space-2xl);
  }

  .program-page__pitch {
    margin-top: var(--space-3xl);
    padding-block: var(--space-3xl);
    background: var(--color-evening);
    color: var(--color-evening-contrast);
  }

  .program-page__pitch-heading {
    color: var(--color-evening-contrast);
    font-size: var(--text-xl);
  }

  .program-page__pitch-text {
    margin-top: var(--space-md);
    color: var(--color-evening-contrast);
    opacity: 0.85;
  }

  .program-page__pitch-actions {
    margin-top: var(--space-xl);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-lg);
  }

  .program-page__pitch :global(.download-link) {
    color: var(--color-evening-contrast);
  }

  @media (max-width: 56rem) {
    .program-hero__grid {
      grid-template-columns: 1fr;
    }

    .program-hero__figure {
      max-width: 24rem;
    }
  }
</style>
