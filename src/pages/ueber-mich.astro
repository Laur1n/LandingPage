---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SubpageHero from "../components/blocks/SubpageHero.astro";
import Prose from "../components/blocks/Prose.astro";
import PullQuote from "../components/blocks/PullQuote.astro";
import { getSiteTexts } from "../lib/site-texts";

const [about] = await getCollection("about");
const { Content } = await render(about);
const { brand, nav, subpages } = await getSiteTexts();

const portrait = about.data.portraitPage ?? about.data.portrait;
const portraitAlt = about.data.portraitPageAlt ?? about.data.portraitAlt;
---

<BaseLayout title={`${nav.ueberMich} · ${brand}`} description={about.data.tagline}>
  <SubpageHero
    eyebrow={subpages.aboutEyebrow}
    heading={subpages.aboutHeading}
    intro={about.data.tagline}
  />

  <div class="container about-page__grid">
    <figure class="about-page__portrait" data-scene="vita-portrait">
      <img src={portrait} alt={portraitAlt} loading="eager" decoding="async" />
    </figure>
    <Prose>
      <Content />
    </Prose>
  </div>

  {
    about.data.pullQuote && (
      <div class="container">
        <PullQuote quote={about.data.pullQuote} />
      </div>
    )
  }
</BaseLayout>

<style>
  .about-page__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-3xl);
    align-items: start;
  }

  .about-page__portrait {
    margin: 0;
    position: sticky;
    top: var(--space-3xl);
  }

  .about-page__portrait img {
    border-radius: 0.25rem;
    width: 100%;
  }

  @media (max-width: 56rem) {
    .about-page__grid {
      grid-template-columns: 1fr;
    }

    .about-page__portrait {
      position: static;
      max-width: 22rem;
    }
  }
</style>
