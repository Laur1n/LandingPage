---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Bereiche from "../components/sections/Bereiche.astro";
import About from "../components/sections/About.astro";
import Kontakt from "../components/sections/Kontakt.astro";
import PullQuote from "../components/blocks/PullQuote.astro";
import CuePilotDemo from "../components/blocks/CuePilotDemo.astro";
import { getSiteTexts } from "../lib/site-texts";

const [about] = await getCollection("about");
const { seoTitle, seoDescription, hero } = await getSiteTexts();
---

<BaseLayout title={seoTitle} description={seoDescription}>
  <section id="start" class="hero">
    <div class="container hero__grid">
      <div class="hero__inner">
        <p class="hero__eyebrow" data-hero-line>{hero.welcome}</p>
        <h1 class="hero__headline" data-hero-line>{hero.name}</h1>
        <p class="hero__intro" data-hero-line>{hero.intro}</p>
        <div class="hero__actions" data-hero-line>
          <a class="cta-pill" href="/cue-pilot/">{hero.primaryCtaLabel}</a>
          <a class="hero__ghost" href="#bereiche">{hero.secondaryCtaLabel}</a>
        </div>
        <p class="hero__byline" data-hero-line>{hero.role}</p>
      </div>
      <div class="hero__visual" data-hero-line>
        <CuePilotDemo />
      </div>
    </div>
  </section>

  <Bereiche />

  {
    about.data.pullQuote && (
      <div class="container quote-band" data-scene="quote-scene">
        <PullQuote quote={about.data.pullQuote} />
      </div>
    )
  }

  <About />
  <Kontakt />
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-3xl) var(--space-4xl);
    border-bottom: 2px solid var(--color-ink);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: var(--space-3xl);
    align-items: start;
  }

  .hero__inner {
    max-width: 34rem;
    padding-top: var(--space-md);
  }

  .hero__eyebrow {
    margin: 0 0 var(--space-lg);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-bauhaus-red);
  }

  .hero__headline {
    font-size: var(--text-3xl);
    text-wrap: balance;
    margin-bottom: var(--space-xl);
    max-width: 11ch;
  }

  .hero__intro {
    font-size: var(--text-lg);
    color: var(--color-ink-muted);
    max-width: 40ch;
    margin-bottom: var(--space-2xl);
    line-height: 1.55;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  .hero__ghost {
    display: inline-block;
    padding: var(--space-sm) var(--space-lg);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-ink);
    border: 2px solid var(--color-ink);
  }

  .hero__ghost:hover,
  .hero__ghost:focus-visible {
    background: var(--color-ink);
    color: var(--color-surface);
  }

  .hero__byline {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    max-width: none;
  }

  .hero__visual {
    justify-self: end;
    width: 100%;
  }

  .quote-band {
    padding-block: var(--space-3xl);
    border-bottom: 2px solid var(--color-ink);
  }

  @media (max-width: 56rem) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }

    .hero__headline {
      max-width: none;
    }

    .hero__visual {
      justify-self: stretch;
    }
  }
</style>
