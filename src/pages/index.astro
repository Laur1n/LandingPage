---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Bereiche from "../components/sections/Bereiche.astro";
import About from "../components/sections/About.astro";
import Kontakt from "../components/sections/Kontakt.astro";
import PullQuote from "../components/blocks/PullQuote.astro";
import { getSiteTexts } from "../lib/site-texts";

const [about] = await getCollection("about");
const { seoTitle, seoDescription, hero } = await getSiteTexts();
---

<BaseLayout title={seoTitle} description={seoDescription}>
  <section id="start" class="hero">
    <div class="container hero__grid">
      <div class="hero__inner">
        <p class="hero__welcome" data-hero-line>{hero.welcome}</p>
        <h1 class="hero__name" data-hero-line>{hero.name}</h1>
        <p class="hero__role" data-hero-line>{hero.role}</p>
        <p class="hero__intro" data-hero-line>{about.data.tagline}</p>
        <div class="hero__actions" data-hero-line>
          <a class="cta-pill" href="/kontakt/">{hero.primaryCtaLabel}</a>
          <a class="hero__cta--secondary" href="#bereiche">{hero.secondaryCtaLabel}</a>
        </div>
      </div>
      <figure class="hero__figure">
        <img
          src={hero.image}
          alt={hero.imageAlt}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          data-hero-image
        />
      </figure>
    </div>
  </section>

  <Bereiche />

  {
    about.data.pullQuote && (
      <div class="container" data-scene="quote-scene">
        <PullQuote quote={about.data.pullQuote} />
      </div>
    )
  }

  <About />
  <Kontakt />
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-3xl);
    overflow: clip;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: var(--space-3xl);
    align-items: center;
    min-height: min(88svh, 56rem);
  }

  .hero__inner {
    max-width: 40rem;
  }

  .hero__figure {
    margin: 0;
    align-self: stretch;
    display: flex;
  }

  .hero__figure img {
    width: 100%;
    height: 100%;
    max-height: min(78svh, 52rem);
    object-fit: cover;
    border-radius: 0.25rem;
  }

  .hero__welcome {
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: var(--text-sm);
    color: var(--color-accent);
    font-weight: 600;
    margin-bottom: var(--space-lg);
  }

  .hero__name {
    font-size: var(--text-3xl);
    letter-spacing: -0.01em;
    text-wrap: balance;
    margin-bottom: var(--space-md);
  }

  .hero__role {
    font-size: var(--text-lg);
    font-family: var(--font-display);
    font-style: italic;
    color: var(--color-ink-muted);
    margin: 0 0 var(--space-lg);
  }

  .hero__intro {
    font-size: var(--text-lg);
    color: var(--color-ink-muted);
    max-width: 44ch;
    margin-bottom: var(--space-2xl);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .hero__cta--secondary {
    display: inline-block;
    padding: var(--space-sm) var(--space-xl);
    border-radius: 999px;
    text-decoration: none;
    font-weight: 600;
    font-size: var(--text-sm);
    background: transparent;
    color: var(--color-ink);
    border: 1px solid var(--color-border);
    transition:
      border-color var(--duration-base) var(--ease-out-expo),
      color var(--duration-base) var(--ease-out-expo);
  }

  .hero__cta--secondary:hover,
  .hero__cta--secondary:focus-visible {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  @media (max-width: 56rem) {
    .hero__grid {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .hero__figure img {
      max-height: 52svh;
    }
  }
</style>
