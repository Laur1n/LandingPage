---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSiteTexts } from "../lib/site-texts";
import { formatUpdatedDate } from "../lib/format";

const entry = await getEntry("legal", "impressum");
if (!entry) {
  throw new Error("Legal entry 'impressum' must exist — see src/content/legal/de");
}
const { Content } = await render(entry);
const { brand, legalPages } = await getSiteTexts();
---

<BaseLayout title={`${entry.data.title} · ${brand}`} description={legalPages.impressumDescription}>
  <article class="container legal-page">
    <p class="section-eyebrow">{legalPages.eyebrow}</p>
    <h1 class="section-heading">{entry.data.title}</h1>
    <p class="legal-page__updated">
      {legalPages.updatedLabel}: {formatUpdatedDate(entry.data.lastUpdated)}
    </p>
    <div class="legal-page__body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .legal-page {
    padding-block: var(--space-3xl) var(--space-4xl);
    max-width: 65ch;
  }

  .legal-page__updated {
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }

  .legal-page__body :global(p) {
    color: var(--color-ink);
  }
</style>
