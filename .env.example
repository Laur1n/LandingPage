# Copy this file to .env for local development if you ever need to override anything below.
# There are no server-side secrets required to build or deploy this site: GitHub Actions
# deploys to GitHub Pages using its own built-in credentials, and Decap CMS's DecapBridge/git-gateway
# backend needs no server-held tokens of ours either.

# --- Decap CMS auth backend (public/admin/config.yml) ---
# Not a secret (it's embedded in the public admin bundle) — update per deployment when registering
# a new DecapBridge site. See TEMPLATE.md for the full setup checklist.
DECAPBRIDGE_SITE_ID=e380cd0b-df6a-4278-963b-8eb57fc3bab9
